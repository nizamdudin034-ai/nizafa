# Nizafa — environment variables (copy to .env.local; NEVER commit real values)
# Fill these in the Netlify dashboard (Site settings → Environment variables)
# for production. The browser reads each value from its own signed-in
# dashboard session — no secret ever goes in chat, git, or this file.

# --- Supabase (project "nizafa", https://btqueqyatpatxqyfanzo.supabase.co) ---
# From Supabase dashboard → Project Settings → API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key is SERVER-ONLY (bypasses RLS). Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- YouTube Data API v3 (Google Cloud project 'Nizafa') ---
# Server-only. From Google Cloud Console → APIs & Services → Credentials.
# Quota: 10,000 units/day; search.list is capped at 100 calls/day for the
# whole app, so the app caches channel/video data in Supabase (see lib/youtube.ts).
YOUTUBE_API_KEY=

# --- Google OAuth (YouTube channel connect, step 2 — optional in v1) ---
# A "Web application" OAuth client in the same Google Cloud project.
# Redirect URI (must match EXACTLY in Google Cloud):
#   https://<your-site>.netlify.app/nizafa-auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# NEXT_PUBLIC_APP_URL is also the OAuth redirect base.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Owner (plan approvals, payment review) ---
# The Google email that counts as the workspace owner.
OWNER_EMAIL=nizamdudin034@gmail.com

# --- Daily ideas cron (Netlify Scheduled Function calls this) ---
# Random 32-char secret. Same value in Netlify env vars. The cron route
# refuses all calls (503) when this is not set.
CRON_SECRET=
# If set, /api/thumbnail-image calls the provider; otherwise the Thumbnail
# Studio canvas composer is used (no key needed).
# REPLICATE_API_TOKEN=
# OPENAI_API_KEY=

# --- ElevenLabs (voiceover generation on /generate) ---
# If set, the Voiceover section generates MP3 narration from the script
# draft. The owner can also paste a key in Settings (owner-only, stored
# in the settings table, never shown again); the env var takes
# precedence. Get a key at https://elevenlabs.io/app/settings/api-keys
# (free tier: 10,000 characters a month). KikiVoice has no public API,
# so it cannot be used inside the app.
# ELEVENLABS_API_KEY=
